# Docker Compose deployment settings. These are not application secrets.
# Authentication, OAuth and allowed origins belong in config/config.yaml.
AIRIPRESS_WEB_PORT=3000
AIRIPRESS_BIND_ADDRESS=127.0.0.1
AIRIPRESS_IMAGE_OWNER=mo2iairi
AIRIPRESS_VERSION=latest

# Optional persistent paths; relative paths are resolved from compose.yaml.
AIRIPRESS_DATA_DIR=./data
AIRIPRESS_IMPORT_DIR=./imports
